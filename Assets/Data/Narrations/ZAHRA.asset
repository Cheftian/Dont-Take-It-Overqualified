  m_Script: {fileID: 11500000, guid: 14c4bad32280b534ba5ccbea81ef9a38, type: 3}
  m_Name: ZAHRA
  m_EditorClassIdentifier: 
  targetCharacterId: Zahra
  introLines:
  - isHRD: 0
    expressionId: Normal
    sentence: Pagi. Iya, saya Zahra Ladiva, kak. Eh, maksudnya--ya udah lah terlanjur.
  - isHRD: 0
    expressionId: Normal
    sentence: Bener, kak. Saya <b>ngelamar posisi desain grafis.</b>
  skillLines:
  - isHRD: 1
    expressionId: 
    sentence: Apa saja skill/pengalaman kamu?
  - isHRD: 0
    expressionId: Normal
    sentence: Nggak banyak sih. Tapi biasanya saya pakai Aduhbe Illustrator, Feegma,
      sama Kreta. Aplikasi standar kampus.
  - isHRD: 0
    expressionId: Normal
    sentence: Kalau pengalaman... cuman magang desain grafis sama open commis buat
      jajan Komifomo.
  salaryLines:
  - isHRD: 1
    expressionId: 
    sentence: Ada ekspektasi gaji?
  - isHRD: 0
    expressionId: Normal
    sentence: Berapa aja aman sih. Pokoknya keterima kerja. Saya males nganggur di
      rumah. Mana commis sepi.
  outroLines:
  - isHRD: 1
    expressionId: 
    sentence: Sudahi wawancara
  - isHRD: 0
    expressionId: Normal
    sentence: Wokeh, kak! Makasih banyak.
