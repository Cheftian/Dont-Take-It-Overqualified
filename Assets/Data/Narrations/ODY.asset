  m_Script: {fileID: 11500000, guid: 14c4bad32280b534ba5ccbea81ef9a38, type: 3}
  m_Name: ODY
  m_EditorClassIdentifier: 
  targetCharacterId: Ody
  introLines:
  - isHRD: 0
    expressionId: Normal
    sentence: S-selamat pagi. Saya Odysseus Liebert.
  - isHRD: 0
    expressionId: Normal
    sentence: Saya yang <b>melamar, u-uhh itu... desain grafis.</b> I-iya, itu.
  skillLines:
  - isHRD: 1
    expressionId: 
    sentence: Apa saja skill/pengalaman kamu?
  - isHRD: 0
    expressionId: Normal
    sentence: S-saya dulu sering bantu-bantu kampus... sama teman, sama dosen.
  - isHRD: 0
    expressionId: Normal
    sentence: Saya juga open commis. S-sudah lama juga sejak awal kuliah.
  - isHRD: 0
    expressionId: Normal
    sentence: Setelah lulus, s-saya kerja di studio FlowerBloom. Sebagai... staff...
      animator.
  salaryLines:
  - isHRD: 1
    expressionId: 
    sentence: Ada ekspektasi gaji?
  - isHRD: 0
    expressionId: Normal
    sentence: Mungkin... sekitar 6,5 juta?
  - isHRD: 0
    expressionId: Normal
    sentence: E-eh, kalau nggak keberatan maksudnya. Normalnya... segitu.
  outroLines:
  - isHRD: 1
    expressionId: 
    sentence: Sudahi wawancara
  - isHRD: 0
    expressionId: Normal
    sentence: ... Sudah?
  - isHRD: 0
    expressionId: Normal
    sentence: H-hasilnya nggak diumumkan sekarang?
  - isHRD: 0
    expressionId: Normal
    sentence: T-tapi saya... saya bakal diterima kan? CV saya... s-sudah bagus kok!
