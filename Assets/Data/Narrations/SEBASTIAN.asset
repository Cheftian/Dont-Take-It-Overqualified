  introLines:
  - isHRD: 0
    expressionId: Normal
    sentence: Selamat pagi, saya Sebastian Serdian.
  - isHRD: 0
    expressionId: Normal
    sentence: Benar, saya <b>mendaftar sebagai satpam.</b>
  skillLines:
  - isHRD: 1
    expressionId: 
    sentence: Apa saja skill/pengalaman kamu?
  - isHRD: 0
    expressionId: Normal
    sentence: Selama di kampus, saya sering juara Taekwondo dari tingkat nasional
      sampai internasional.
  - isHRD: 0
    expressionId: Normal
    sentence: Pengalaman kerja saya nggak banyak. Cuman jadi satpam di bank DCA selama
      4 tahun.
  - isHRD: 0
    expressionId: Normal
    sentence: Saya bisa pakai Ms.Wood dan Gagaal Meet saja.
  salaryLines:
  - isHRD: 1
    expressionId: 
    sentence: Ada ekspektasi gaji?
  - isHRD: 0
