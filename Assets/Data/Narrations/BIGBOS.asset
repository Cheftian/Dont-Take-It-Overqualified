  skillLines:
  - isHRD: 0
    expressionId: Normal
    sentence: Bagaimana perkembangan tes teknis kandidat baru?
  - isHRD: 1
    expressionId: 
    sentence: Sebagian besar sudah menyelesaikan ujian praktek, Pak.
  - isHRD: 0
    expressionId: Normal
    sentence: Pastikan standarnya tinggi, jangan asal lolos.
  - isHRD: 1
    expressionId: 
    sentence: Baik Pak, kami seleksi dengan ketat.
  salaryLines:
  - isHRD: 0
    expressionId: Normal
    sentence: Sudah ada rekap penawaran gaji bulan ini?
  - isHRD: 1
    expressionId: 
    sentence: Sudah kami susun sesuai anggaran divisi, Pak.
  - isHRD: 0
    expressionId: Normal
    sentence: Evaluasi lagi benefit tambahan untuk posisi kunci.
  - isHRD: 1
    expressionId: 
