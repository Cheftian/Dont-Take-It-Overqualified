  m_Script: {fileID: 11500000, guid: 14c4bad32280b534ba5ccbea81ef9a38, type: 3}
  m_Name: GANDARI
  m_EditorClassIdentifier: 
  targetCharacterId: Gandari
  introLines:
  - isHRD: 0
    expressionId: Normal
    sentence: Selamat pagi. Benar, saya Gandari Widuri.
  - isHRD: 0
    expressionId: Normal
    sentence: Saya melamar posisi asisten manager.
  skillLines:
  - isHRD: 1
    expressionId: 
    sentence: Apa saja skill/pengalaman kamu?
  - isHRD: 0
    expressionId: Normal
    sentence: Saya pernah magang di kantor De Tok saat saya masih berkuliah. Dan
      diterima menjadi akuntansi tetap disana selama 3 tahun.
  - isHRD: 0
    expressionId: Normal
    sentence: Selama kuliah, saya pernah menjadi asisten dosen manajemen akuntansi
      kurang lebih 2 semester. Kebetulan beliau selalu sekelas dengan saya, jadi
      sekalian saja 2 periode.
  - isHRD: 0
    expressionId: Normal
    sentence: Saya mampu mengoperasikan banyak aplikasi, utamanya Ms.X-cell, Ms.Wood,
      Gagaal Meet, dan Breloo selama bekerja.
  salaryLines:
  - isHRD: 1
    expressionId: 
    sentence: Ada ekspektasi gaji?
  - isHRD: 0
    expressionId: Normal
    sentence: Dengan pengalaman dan skill saya, saya yakin bisa memberikan dampak
      yang besar untuk perusahaan.
  - isHRD: 0
    expressionId: Normal
    sentence: Karena itu, saya rasa gaji 7-8 juta ekspektasi saya.
  outroLines:
  - isHRD: 1
    expressionId: 
    sentence: Sudahi wawancara
  - isHRD: 0
    expressionId: Normal
    sentence: Terimakasih atas waktu anda.
